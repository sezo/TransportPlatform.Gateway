{
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/transport",
    "Audience": "internal-gateway"
  },
  "Observability": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "accounting-auth": {
        "ClusterId": "accounting",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/accounting/auth/{**catch-all}"
        }
      },
      "accounting": {
        "ClusterId": "accounting",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/api/accounting/{**catch-all}"
        }
      },
      "ticketing": {
        "ClusterId": "ticketing",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/api/ticketing/{**catch-all}"
        }
      },
      "vehicles": {
        "ClusterId": "vehicles",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/api/vehicles/{**catch-all}"
        }
      },
            "reporting-hub": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/reporting/hubs/{**catch-all}"
        }
      },
      "reporting": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": {
          "Path": "/api/reporting/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "accounting": {
        "Destinations": {
          "accounting-1": {
            "Address": "http://accounting-svc:5101"
          }
        }
      },
      "ticketing": {
        "Destinations": {
          "ticketing-1": {
            "Address": "http://ticketing-svc-1:5001"
          },
          "ticketing-2": {
            "Address": "http://ticketing-svc-2:5002"
          }
        }
      },
      "vehicles": {
        "Destinations": {
          "vehicle-1": {
            "Address": "http://vehicle-svc:5003"
          }
        }
      },
            "reporting-hub": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "default",
        "Match": {
          "Path": "/api/reporting/hubs/{**catch-all}"
        }
      },
      "reporting": {
        "Destinations": {
          "reporting-1": {
            "Address": "http://reporting-svc:5201"
          }
        }
      }
    }
  }
}