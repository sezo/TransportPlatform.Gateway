{
  "Keycloak": {
    "Authority": "http://keycloak:8080/realms/transport",
    "Audience": "public-gateway",
    "TokenEndpoint": "http://keycloak:8080/realms/transport/protocol/openid-connect/token",
    "GatewayClientId": "public-gateway",
    "GatewayClientSecret": "change-me-in-production"
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Observability": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "ReverseProxy": {
    "Routes": {
      "ticketing": {
        "ClusterId": "ticketing",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/ticketing/{**catch-all}" }
      },
      "accounting": {
        "ClusterId": "accounting",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/accounting/{**catch-all}" }
      },
      "vehicles": {
        "ClusterId": "vehicles",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/vehicles/{**catch-all}" }
      },
      "reporting": {
        "ClusterId": "reporting",
        "AuthorizationPolicy": "default",
        "RateLimiterPolicy": "per-user",
        "Match": { "Path": "/api/reporting/{**catch-all}" }
      }
    },
    "Clusters": {
      "ticketing": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          },
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:02:00"
          }
        },
        "Destinations": {
          "ticketing-1": { "Address": "http://ticketing-svc-1:5001" },
          "ticketing-2": { "Address": "http://ticketing-svc-2:5002" }
        }
      },
      "accounting": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "accounting-1": { "Address": "http://accounting-svc:5004" }
        }
      },
      "vehicles": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "vehicle-1": { "Address": "http://vehicle-svc:5003" }
        }
      },
      "reporting": {
        "LoadBalancingPolicy": "LeastRequests",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Path": "/health"
          }
        },
        "Destinations": {
          "reporting-1": { "Address": "http://reporting-svc:5005" }
        }
      }
    }
  }
}
